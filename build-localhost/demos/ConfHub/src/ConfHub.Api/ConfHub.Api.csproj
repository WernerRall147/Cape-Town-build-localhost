<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ConfHub.Api</RootNamespace>
    <AssemblyName>ConfHub.Api</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Azure Cosmos DB -->
    <PackageReference Include="Microsoft.Azure.Cosmos" Version="3.46.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />

    <!-- Azure AI Foundry — GA Persistent Agents SDK (keyless, Entra ID auth) -->
    <PackageReference Include="Azure.AI.Agents.Persistent" Version="1.1.0" />
    <PackageReference Include="Azure.Identity" Version="1.13.2" />

    <!-- MCP Server for ASP.NET Core -->
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="0.3.0-preview.3" />

    <!-- Built-in OpenAPI (.NET 10) + Scalar interactive API reference -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.6.9" />
  </ItemGroup>

</Project>
