# Sample environment file for the ConfHub demo.
#
# Copy this file to .azure/.env and fill in your own Azure subscription and tenant.
# The real .azure/.env is git-ignored so your IDs are never committed.
#
#   cp .env.sample .azure/.env
#
subscription_id=00000000-0000-0000-0000-000000000000
tenant_id=00000000-0000-0000-0000-000000000000
